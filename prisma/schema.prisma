datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?

  // bcrypt hash — never selected into an API response. Reads that leave the
  // repository layer go through the `safeUserSelect` projection.
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  author    User    @relation(fields: [authorId], references: [id])
  authorId  Int
}
