# Copy this file to .env and fill in the values:
#
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials.
# Keys here must stay in sync with src/config/env.ts.

# --- Required ---------------------------------------------------------------

# Postgres connection string. Read by both the app (src/config/env.ts) and the
# Prisma CLI (prisma.config.ts). Startup fails with a clear error if unset.
#
# Prisma Postgres: copy the connection string from the Prisma Console.
# Local Postgres:  postgresql://USER:PASSWORD@localhost:5432/myapp
#
# Note: prefer sslmode=verify-full over sslmode=require — in pg v9 the weaker
# modes change meaning, and `require` currently emits a deprecation warning.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"

# Signing key for the auth JWT (src/utils/jwt.ts). Minimum 32 characters.
# Generate one with: openssl rand -base64 48
# Rotating this invalidates every issued token, signing all users out.
JWT_SECRET=""

# --- Optional (defaults shown) ----------------------------------------------

# Port the HTTP server listens on.
PORT=3000

# development | production — controls the Prisma client singleton in
# src/lib/prisma.ts, error-response detail, and the `secure` flag on the auth
# cookie (which requires HTTPS, so it is off outside production).
NODE_ENV=development

# Access-token lifetime, as an `ms`-style duration string (e.g. 15m, 12h, 7d).
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to send credentialed requests.
# The auth cookie only reaches the API from an origin listed here.
CORS_ORIGINS=http://localhost:3000
